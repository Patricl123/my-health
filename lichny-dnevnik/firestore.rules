rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == 'OWNER_UID' && request.auth.uid == uid;
    }
    function validEntry(date) {
      let d = request.resource.data;
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasAll(['date', 'stress', 'mood', 'note', 'diary', 'meals', 'version', 'updatedAt', 'mutationId'])
        && d.keys().hasOnly(['date', 'stress', 'mood', 'note', 'diary', 'meals', 'version', 'updatedAt', 'mutationId'])
        && d.date == date
        && (d.stress == null || (d.stress is int && d.stress >= 0 && d.stress <= 10))
        && d.mood in ['', 'great', 'good', 'neutral', 'sad', 'hard']
        && d.note is string && d.note.size() <= 5000
        && d.diary is string && d.diary.size() <= 50000
        && d.meals is list && d.meals.size() <= 40
        && d.version is int && d.updatedAt == request.time
        && d.mutationId is string && d.mutationId.size() <= 64;
    }
    match /users/{uid}/entries/{date} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validEntry(date) && request.resource.data.version == 1;
      allow update: if isOwner(uid) && validEntry(date) && request.resource.data.version == resource.data.version + 1;
      allow delete: if isOwner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
